{
  "name": "kam-tong-ham-server",
  "version": "1.0.0",
  "description": "Colyseus multiplayer server for คำต้องห้าม (Forbidden Words) Thai party game",
  "main": "server/dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node server/dist/index.js",
    "dev": "ts-node-dev --respawn server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.0",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "colyseus": "^0.15.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.36",
    "@colyseus/testing": "^0.17.11",
    "@colyseus/tools": "^0.17.19",
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
